{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanartist.dev/spec/v1/schema/store.schema.json",
  "title": "KanArtist .ka/store.yml, spec v1 §5.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "name"
  ],
  "properties": {
    "spec": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "description": {
      "type": "string"
    },
    "extends": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string"
          }
        }
      }
    }
  }
}
