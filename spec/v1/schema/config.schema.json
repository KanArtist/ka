{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanartist.dev/spec/v1/schema/config.schema.json",
  "title": "KanArtist data config (.ka/config.yml and project.yml config:), spec v1 §6.6",
  "description": "A layer may set any key to null to delete an inherited value (§6.3).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id_suffix_length": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 5,
      "maximum": 8
    },
    "workflow": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "category"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "category": {
                "enum": [
                  "triage",
                  "backlog",
                  "unstarted",
                  "started",
                  "completed",
                  "canceled"
                ]
              },
              "blocked": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "initial": {
          "type": "string"
        },
        "agent_created_initial": {
          "type": "string"
        }
      }
    },
    "kinds": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "$append": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "$remove": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "labels": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "closed": {
          "type": "boolean"
        },
        "known": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "$append": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "$remove": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "fields": {
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "text",
                  "number",
                  "integer",
                  "boolean",
                  "enum",
                  "date",
                  "timestamp",
                  "actor",
                  "url",
                  "id",
                  "list"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "claims": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "stale_after": {
          "type": "string",
          "pattern": "^([0-9]+d|([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+)$"
        }
      }
    },
    "comments": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "progress_min_interval": {
          "type": "string",
          "pattern": "^([0-9]+d|([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+)$"
        }
      }
    },
    "attachments": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "template": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "sections": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "$append": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "$remove": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "locked": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "runtime": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
