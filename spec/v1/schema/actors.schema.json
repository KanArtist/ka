{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanartist.dev/spec/v1/schema/actors.schema.json",
  "title": "KanArtist .ka/actors.yml, spec v1 §5.4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "humans": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "emails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "pattern": "^agent/[a-z0-9][a-z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^((agent|role)/)?[a-z0-9][a-z0-9._-]{0,63}$"
        }
      }
    }
  }
}
