{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanartist.dev/spec/v1/schema/ticket.schema.json",
  "title": "KanArtist ticket frontmatter (ticket.md), spec v1 §4.2",
  "description": "Config-dependent rules (status, kind, labels, custom field types) are checked by ka check against the project's effective config, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "created",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9A-HJKMNP-TV-Z]{5,8}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[^\\n\\r]*$"
    },
    "status": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^\\s,][^,\\n]{0,63}$"
      },
      "uniqueItems": true
    },
    "assignee": {
      "type": "string",
      "pattern": "^((agent|role)/)?[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "owner": {
      "type": "string",
      "pattern": "^((agent|role)/)?[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "at"
      ],
      "properties": {
        "by": {
          "type": "string",
          "pattern": "^((agent|role)/)?[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "session": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "at": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
        }
      }
    },
    "parent": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9A-HJKMNP-TV-Z]{5,8}$"
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9A-HJKMNP-TV-Z]{5,8}$"
      },
      "uniqueItems": true
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9A-HJKMNP-TV-Z]{5,8}$"
      },
      "uniqueItems": true
    },
    "duplicate_of": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9A-HJKMNP-TV-Z]{5,8}$"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z][a-z0-9-]{0,31}://[^@#\\s]+(@[^#\\s]+)?(#L[0-9]+(-L?[0-9]+)?)?|https?://\\S+)$"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "done": {
            "type": "boolean"
          }
        }
      }
    },
    "milestone": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "due": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "moved_to": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9A-HJKMNP-TV-Z]{5,8}$"
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "created_by": {
      "type": "string",
      "pattern": "^((agent|role)/)?[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    }
  }
}
